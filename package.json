{
  "name": "simerald",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "description": "Public card-wall website for a personal SIM and eSIM collection kept as Obsidian notes, running on Cloudflare Workers. Based on the Komari Emerald theme.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build-only && wrangler dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "check": "eslint . && vue-tsc --build && vite build",
    "deploy": "npm run check && wrangler deploy --var GIT_HASH:$(git rev-parse --short HEAD)"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.1",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.28",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.0.2",
    "vue-sonner": "^2.0.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@iconify/json": "^2.2.442",
    "@tailwindcss/vite": "^4.1.16",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.4",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "tinypool": "^2.1.2"
  }
}
